# ============================================
# CleanTrack — Environment Variables
# ============================================
# Salin file ini ke .env dan isi sesuai environment lokal Anda.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://cleantrack:cleantrack_pass@localhost:5432/cleantrack_db?schema=public

# --- Aplikasi ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Redis (untuk BullMQ — dipakai mulai Task 6) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT (dipakai mulai Task 2+) ---
# JWT_SECRET=ganti_dengan_secret_aman
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_SECRET=ganti_dengan_refresh_secret_aman
# JWT_REFRESH_EXPIRES_IN=7d

# --- Storage / S3 / R2 (dipakai mulai Task 3) ---
# STORAGE_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=cleantrack-photos
# STORAGE_PUBLIC_URL=https://cdn.cleantrack.id

# --- WhatsApp Cloud API (dipakai mulai Task 6) ---
# WHATSAPP_API_URL=https://graph.facebook.com/v17.0
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# --- Payment Gateway (future) ---
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false

# --- Firebase Cloud Messaging (future) ---
# FCM_PROJECT_ID=
# FCM_PRIVATE_KEY=
# FCM_CLIENT_EMAIL=

# --- Google Maps (future) ---
# GOOGLE_MAPS_API_KEY=
